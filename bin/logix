#!/usr/bin/env bash
# ==============================================================================
# LOGIX CLI WRAPPER & CONSTITUTIONAL GATES (ast-grep, takeover, A10 ratchet)
# (§4, §6, §8, §12.b, §43, §48, §50)
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Intercepción canónica de versión para paridad SSSoT (§43)
if [ "$1" = "-v" ] || [ "$1" = "--version" ] || [ "$1" = "version" ]; then
  python3 -c "import json, os; p = '$ROOT_DIR/backlog.json'; v = json.load(open(p))['version'] if os.path.exists(p) else '5.5.2'; print(f'logix v{v}')"
  exit 0
fi

# Si el comando es takeover, ejecutar la compuerta física anti-rebote antes de proceder (§50)
if [ "$1" = "takeover" ]; then
  if [ -f "$ROOT_DIR/tools/takeover_gate.dart" ]; then
    dart run "$ROOT_DIR/tools/takeover_gate.dart" "$@" || exit $?
  fi
fi

# Si el comando es handover, ejecutar el handover canónico de Pure Dart (§39, §48, §52, §60.2)
if [ "$1" = "handover" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_handover_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_handover_command.dart" "$@"
  fi
fi

# Si el comando es sync-tasks, ejecutar la verificación física de checkmarks (§18, §48, TASK-N130-04)
if [ "$1" = "sync-tasks" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_sync_tasks_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_sync_tasks_command.dart" "${@:2}"
  fi
fi

# Si el comando es install-hooks o hooks, despachar a logix_install_hooks_command (§12.b, §55)
if [ "$1" = "install-hooks" ] || [ "$1" = "hooks" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_install_hooks_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_install_hooks_command.dart" "${@:2}"
  fi
fi

# Si el comando es fleet-sweep, despachar a logix_fleet_sweep_command (§55, TASK-N131-04)
if [ "$1" = "fleet-sweep" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_fleet_sweep_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_fleet_sweep_command.dart" "${@:2}"
  fi
fi

# Si el comando es dora, despachar a logix_dora_command (§45, §47, §54, TASK-N143-04)
if [ "$1" = "dora" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_dora_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_dora_command.dart" "${@:2}"
  fi
fi

# Si el comando es maintenance, despachar a logix_maintenance_command (§48, §52, TASK-N131-05)
if [ "$1" = "maintenance" ]; then
  if [ -f "$ROOT_DIR/lib/src/commands/logix_maintenance_command.dart" ]; then
    exec dart run "$ROOT_DIR/lib/src/commands/logix_maintenance_command.dart" "${@:2}"
  fi
fi

# Despacho canónico ultrarrápido de verificación telemétrica MCCV v2 (§50, §50-bis)
if [ "$1" = "check" ]; then
  python3 -c "
import json, os, sys

json_output = '--json' in sys.argv
home = os.environ.get('HOME') or os.environ.get('USERPROFILE') or ''
odo_path = os.path.join('$ROOT_DIR', 'vault', 'runtime', 'session_odometer.json')

offset = 0
conv_id = ''
peak_depth = 0.0

# 1. Detectar conversación activa por mtime más reciente en brain
brain_dir = os.path.join(home, '.gemini', 'antigravity-cli', 'brain')
active_conv_id = ''
if os.path.exists(brain_dir):
    subdirs = [os.path.join(brain_dir, x) for x in os.listdir(brain_dir) if os.path.isdir(os.path.join(brain_dir, x)) and not x.startswith('.')]
    def get_t_mtime(d):
        t = os.path.join(d, '.system_generated', 'logs', 'transcript.jsonl')
        return os.path.getmtime(t) if os.path.exists(t) else 0
    if subdirs:
        subdirs.sort(key=get_t_mtime, reverse=True)
        active_conv_id = os.path.basename(subdirs[0])

if os.path.exists(odo_path):
    try:
        with open(odo_path) as f:
            d = json.load(f)
            stored_conv = d.get('conversation_uuid', '')
            if active_conv_id and stored_conv == active_conv_id:
                offset = d.get('takeover_bytes_offset', 0)
                conv_id = stored_conv
                peak_depth = d.get('epocal_peak_depth', 0.0)
            else:
                conv_id = active_conv_id or stored_conv
                offset = d.get('takeover_bytes_offset', 0)
                peak_depth = 0.0
    except:
        conv_id = active_conv_id
else:
    conv_id = active_conv_id

net_bytes = 0
tool_calls = 0
user_turns = 0
failed_steps = 0
touched_files = set()

if conv_id:
    t_path = os.path.join(home, '.gemini', 'antigravity-cli', 'brain', conv_id, '.system_generated', 'logs', 'transcript.jsonl')
    if os.path.exists(t_path):
        try:
            total_size = os.path.getsize(t_path)
            if offset <= 0 or offset > total_size:
                # Si no había offset previo para esta conversación, fijar base en arranque
                offset = total_size
            with open(t_path) as f:
                f.seek(offset)
                session_lines = f.readlines()
            for line in session_lines:
                line = line.strip()
                if not line:
                    continue
                if line.startswith('{') and line.endswith('}'):
                    try:
                        ev = json.loads(line)
                        typ = str(ev.get('type', '')).upper()
                        status = str(ev.get('status', '')).upper()
                        if typ in ('USER_INPUT', 'USER_EXPLICIT'):
                            user_turns += 1
                        if status in ('ERROR', 'FAILED'):
                            failed_steps += 1
                        tc = ev.get('tool_calls') or ev.get('toolCalls') or []
                        if isinstance(tc, list):
                            tool_calls += len(tc)
                            for item in tc:
                                if isinstance(item, dict):
                                    args = item.get('arguments') or item.get('parameters') or {}
                                    if isinstance(args, dict):
                                        p = args.get('Path') or args.get('path') or args.get('file')
                                        if p:
                                            touched_files.add(str(p))
                        elif tc:
                            tool_calls += 1
                    except:
                        pass
            net_bytes = max(0, total_size - offset)
        except:
            pass

# Motor Matemático Canónico MCCV v2 (§50-bis)
harness_bytes = 140000
ceiling = 500000
useful_window = ceiling - harness_bytes

context_sat = min(1.0, max(0.0, float(net_bytes - harness_bytes)) / float(useful_window)) if net_bytes > harness_bytes else 0.0
effective_turns = max(3, user_turns)
net_tools = max(0, tool_calls - 4)
tool_density = min(1.0, float(net_tools) / float(effective_turns * 12.0))
mutation_disp = min(1.0, float(len(touched_files)) / 10.0)
fail_entropy = min(1.0, float(failed_steps) / float(max(1, user_turns + tool_calls))) if failed_steps > 0 else 0.0

composite_score = (context_sat * 0.30) + (tool_density * 0.30) + (mutation_disp * 0.20) + (fail_entropy * 0.20)
odometer_pct = composite_score * 100.0

depth = max(peak_depth, odometer_pct)

# Actualizar sesión y peak_depth en session_odometer.json
if os.path.exists(odo_path):
    try:
        with open(odo_path, 'r+') as f:
            d = json.load(f)
            d['conversation_uuid'] = conv_id
            d['takeover_bytes_offset'] = offset
            d['epocal_peak_depth'] = depth
            d['peak_depth'] = depth
            f.seek(0)
            json.dump(d, f, indent=2)
            f.truncate()
    except:
        pass

zone = 'VERDE'
exit_code = 0
action = 'CONTINUAR'

if depth >= 75.0:
    zone = 'ROJA'
    exit_code = 2
    action = 'HANDOVER_OBLIGATORIO'
elif depth >= 50.0:
    zone = 'ÁMBAR'
    exit_code = 1
    action = 'ALERTA'

if json_output:
    print(json.dumps({
        'zone': zone,
        'depth': depth,
        'checkpoint': 0,
        'action': action,
        'exit_code': exit_code,
        'telemetry_verified': True
    }))
else:
    print(f'[ZONA: {zone} | Odómetro: {depth:.1f}% | Checkpoint: 0 | Acción: {action}]')

sys.exit(exit_code)
" "$@"
  exit $?
fi

# Despacho federado de directivas tácticas de Praxis (§54)
if [ "$1" = "praxis" ]; then
  exec dart run "$ROOT_DIR/lib/src/commands/logix_praxis_emit.dart" "$@"
fi

# Integración del Motor de Linter Semántico AST (ast-grep) y Trinquete A10 en pre-commit (§4, §6, §8, §12.b)
if [ "$1" = "pre-commit" ]; then
  AST_BIN="$SCRIPT_DIR/ast-grep"
  RULES_FILE="$ROOT_DIR/rules/ast_rules.yaml"
  echo "=== [LOGIX/PRE-COMMIT] Escaneo Semántico AST (ast-grep <100ms) ==="
  if [ -x "$AST_BIN" ] && [ -f "$RULES_FILE" ]; then
    TARGETS=()
    for arg in "${@:2}"; do
      if [ -e "$arg" ]; then
        TARGETS+=("$arg")
      fi
    done
    if [ ${#TARGETS[@]} -gt 0 ]; then
      "$AST_BIN" scan --rule "$RULES_FILE" "${TARGETS[@]}" || exit 1
    else
      STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
      if [ -n "$STAGED" ]; then
        echo "$STAGED" | xargs -r "$AST_BIN" scan --rule "$RULES_FILE" || exit 1
      fi
    fi
  fi
  echo "✅ [LOGIX/PRE-COMMIT] Todos los controles estructurales superados con ast-grep."

  # Trinquete Numérico Anti-Huérfanos y Compuerta de Automa A10 (§8, §48)
  echo "=== [LOGIX/PRE-COMMIT] Validación de Trinquete Numérico de Huérfanos (Compuerta Automa A10) ==="
  RATCHET_GATE="$ROOT_DIR/lib/src/governance/orphan_ratchet_gate.dart"
  if [ -f "$RATCHET_GATE" ]; then
    dart run "$RATCHET_GATE" --pre-commit || exit 1
  fi
  echo "✅ [LOGIX/PRE-COMMIT] Trinquete de huérfanos validado dentro de la línea base."
  exit 0
elif [ "$1" = "orphan-ratchet" ] || [ "$1" = "orphans-ratchet" ]; then
  RATCHET_GATE="$ROOT_DIR/lib/src/governance/orphan_ratchet_gate.dart"
  if [ -f "$RATCHET_GATE" ]; then
    exec dart run "$RATCHET_GATE" "${@:2}"
  else
    echo "❌ Error: orphan_ratchet_gate.dart no encontrado en $RATCHET_GATE" >&2
    exit 1
  fi
elif [ "$1" = "audit" ]; then
  # Si vienen argumentos de archivo específicos (ej. archivo dirty con import ilegal)
  TARGETS=()
  for arg in "${@:2}"; do
    if [ -f "$arg" ]; then
      TARGETS+=("$arg")
    fi
  done
  if [ ${#TARGETS[@]} -gt 0 ]; then
    AST_BIN="$SCRIPT_DIR/ast-grep"
    RULES_FILE="$ROOT_DIR/rules/ast_rules.yaml"
    if [ -x "$AST_BIN" ] && [ -f "$RULES_FILE" ]; then
      echo "=== [LOGIX/AUDIT] Escaneo Semántico AST sobre archivos objetivo ==="
      "$AST_BIN" scan --rule "$RULES_FILE" "${TARGETS[@]}" || exit 1
    fi
  fi
fi

# Despachar al binario nativo compilado
if [ -f "$SCRIPT_DIR/logix.native" ]; then
  exec "$SCRIPT_DIR/logix.native" "$@"
elif [ -f /opt/logix-bundle/bin/logix ]; then
  exec /opt/logix-bundle/bin/logix "$@"
elif [ -f "$SCRIPT_DIR/logix.elf" ]; then
  exec "$SCRIPT_DIR/logix.elf" "$@"
elif command -v logix >/dev/null 2>&1; then
  exec logix "$@"
else
  echo "❌ Error: Binario nativo logix no encontrado en $SCRIPT_DIR o /opt/logix-bundle." >&2
  exit 1
fi
