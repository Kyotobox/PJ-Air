#!/bin/sh
# [CONEXT GOVERNANCE] Universal Pre-commit Hook — Enforzamiento Mecánico Estricto
# §4 Tolerancia Cero Mocks, §6 Sad Paths, §39 Pure Dart, §42 Tríptico Sintáctico, §48 Cero Cambios Colgantes

echo "=== [PRE-COMMIT] CONEXT GOVERNANCE GATE ==="

# 1. Higiene sintáctica en proyectos Dart (§42)
if [ -f "pubspec.yaml" ]; then
  if [ -d "lib" ] || [ -d "test" ]; then
    dart format --output=none --set-exit-if-changed lib/ test/ > /dev/null 2>&1
    if [ $? -ne 0 ]; then
      echo "❌ [LINT-FAIL] Formato Dart desincronizado. Ejecute: dart format ."
      exit 1
    fi
  fi
fi

# 2. Auditoría de ADN y Arquitectura (§4, §39, §43)
if [ -x "./bin/logix" ]; then
  ./bin/logix audit --no-ui
elif [ -x "/home/opc/.local/bin/logix" ]; then
  /home/opc/.local/bin/logix audit --no-ui
elif [ -f "./bin/logix.exe" ]; then
  ./bin/logix.exe audit --no-ui
else
  dart run bin/logix.dart audit --no-ui
fi

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ [AUDIT-FAIL] Auditoría de gobernanza fallida. Commit abortado por el Perímetro Mecánico."
  exit 1
fi

echo "✅ [PRE-COMMIT] Todos los controles pasaron físicamente. Commit autorizado."
exit 0
