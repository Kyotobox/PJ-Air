# https://dart.dev/guides/libraries/private-files
# Global build and tool artifacts
**/build/
**/.dart_tool/
**/windows/flutter/
**/*.log

# Project specific
session.lock
bin/*.exe
bin/*.old
bin/*.bak
bin/*.sig
bin/data/
tool/
output_baseline.txt

# Sensitive keys must stay ignored
vault/po_private.xml
vault/agent_vanguard.xml
vault/keys/

# Global heavy binary exclusions
**/*.pdb
**/ephemeral/
**/flutter_windows.dll
release/
bin/*.dll

# Telemetry and Historial rotation
vault/runtime/
vault/graveyard/
# vault/intel is ALLOWED for system knowledge persistence
!vault/intel/

*.so
*.exe.old
*.exe.bak
*.exe.update
bin/vault/runtime/purgatory/
backups/
bin.old/
scratch/
**/RESTART_REQUIRED
*.db
**/node_modules
**/node_modules/
**/.next/
dist/
out/
*.xlsx
/.meta/
.env
**/.env*
.env.local
.env.*.local
