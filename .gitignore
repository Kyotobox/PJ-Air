# https://dart.dev/guides/libraries/private-files
# Global build and tool artifacts
**/build/
**/.dart_tool/
!packages/axioma/tool/
**/windows/flutter/
**/*.log

# Project specific
session.lock
bin/*.exe
bin/logix
bin/logix.old
bin/logix.bak
bin/*.old
bin/*.bak
bin/*.sig
bin/*.sha256
*.sig
logix.exe.sig
bin/data/
tool/
!packages/axioma/tool/
output_baseline.txt

# Sensitive keys must stay ignored
vault/po_private.xml
vault/agent_vanguard.xml
vault/keys/
vault/credentials/

# Global heavy binary exclusions
**/*.pdb
**/ephemeral/
**/flutter_windows.dll
release/
bin/*.dll

# Telemetry and Historial rotation
dropzone/
vault/runtime/
vault/graveyard/
# vault/intel is ALLOWED for system knowledge persistence
!vault/intel/

*.so
*.exe.old
*.exe.bak
*.exe.update
bin/vault/runtime/purgatory/
backups/
bin.old/
scratch/
**/RESTART_REQUIRED
*.db
.tmp.driveupload/
.meta/prompts/

node_modules/
backend/node_modules/
frontend/node_modules/


.env
.env.*
!.env.example

